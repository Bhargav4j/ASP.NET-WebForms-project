@page
@model Films.Web.Pages.FilmPages.IndexModel
@{
    ViewData["Title"] = "Films";
}

<h1>Films</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Film</a>
</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search films..." value="@Model.SearchTerm" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (Model.Films != null && Model.Films.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var film in Model.Films)
            {
                <tr>
                    <td>@film.Name</td>
                    <td>@film.Description</td>
                    <td>@film.CreatedDate.ToShortDateString()</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@film.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@film.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@film.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No films found.</div>
}
