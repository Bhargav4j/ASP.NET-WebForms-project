@page
@model Films.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>@ViewData["Title"]</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.ShowPasswordRecovery)
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Login</button>
                    <button type="submit" asp-page-handler="ForgotPassword" class="btn btn-link">Forgot Password</button>
                </div>

                <div class="mb-3">
                    <a asp-page="/Account/Register">Register as a new user</a>
                </div>
            </form>
        }
        else
        {
            <h3>Password Recovery</h3>

            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="recoveryMethod" id="secretQuestion" checked />
                    <label class="form-check-label" for="secretQuestion">
                        Secret Question
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="recoveryMethod" id="phoneNumber" />
                    <label class="form-check-label" for="phoneNumber">
                        Phone Number
                    </label>
                </div>
            </div>

            <form method="post" asp-page-handler="RecoverBySecret" id="secretForm">
                <input type="hidden" asp-for="Username" />

                <div class="mb-3">
                    <label>Secret Question</label>
                    <p>@Model.SecretQuestion</p>
                </div>

                <div class="mb-3">
                    <label asp-for="SecretAnswer" class="form-label"></label>
                    <input asp-for="SecretAnswer" class="form-control" />
                    <span asp-validation-for="SecretAnswer" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">View Password</button>
                    <a asp-page="/Account/Login" class="btn btn-secondary">Back to Login</a>
                </div>
            </form>

            <form method="post" asp-page-handler="RecoverByPhone" id="phoneForm" style="display:none;">
                <input type="hidden" asp-for="Username" />

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Mobile Phone (+359)</label>
                    <input asp-for="PhoneNumber" class="form-control" maxlength="9" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">View Password</button>
                    <a asp-page="/Account/Login" class="btn btn-secondary">Back to Login</a>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.RecoveredPassword))
            {
                <div class="alert alert-success">
                    <strong>Your password is:</strong> @Model.RecoveredPassword
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('input[name="recoveryMethod"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.id === 'secretQuestion') {
                    document.getElementById('secretForm').style.display = 'block';
                    document.getElementById('phoneForm').style.display = 'none';
                } else {
                    document.getElementById('secretForm').style.display = 'none';
                    document.getElementById('phoneForm').style.display = 'block';
                }
            });
        });
    </script>
}
