@page
@model Films.Web.Pages.Directors.DetailsModel
@{
    ViewData["Title"] = "Director Details";
}

<h1>Director Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.Director?.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.Director?.LastName</dd>

        <dt class="col-sm-2">Created Date</dt>
        <dd class="col-sm-10">@Model.Director?.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>
<div>
    <a asp-page="Edit" asp-route-id="@Model.Director?.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
