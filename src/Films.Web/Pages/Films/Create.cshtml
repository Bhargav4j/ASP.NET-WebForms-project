@page
@model Films.Web.Pages.Films.CreateModel
@{
    ViewData["Title"] = "Create Film";
}

<h1>Create Film</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Film.Name"></label>
        <input asp-for="Film.Name" class="form-control" />
        <span asp-validation-for="Film.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Film.Description"></label>
        <textarea asp-for="Film.Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Film.Description" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
