@page
@model Films.Web.Pages.Films.CreateModel
@{
    ViewData["Title"] = "Create Film";
}

<div class="container">
    <h1>Create Film</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Year" class="form-label"></label>
                    <input asp-for="Input.Year" class="form-control" />
                    <span asp-validation-for="Input.Year" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Genre" class="form-label"></label>
                    <input asp-for="Input.Genre" class="form-control" />
                    <span asp-validation-for="Input.Genre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
