@page
@model Films.Web.Pages.Films.IndexModel
@{
    ViewData["Title"] = "Films";
}

<div class="container">
    <div class="row mb-3">
        <div class="col">
            <h1>Films</h1>
        </div>
        <div class="col text-end">
            <a asp-page="./Create" class="btn btn-primary">Create New Film</a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search films..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (Model.Films != null && Model.Films.Any())
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Genre</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var film in Model.Films)
                {
                    <tr>
                        <td>@film.Name</td>
                        <td>@film.Year</td>
                        <td>@film.Genre</td>
                        <td>@(film.Description?.Length > 100 ? film.Description.Substring(0, 100) + "..." : film.Description)</td>
                        <td>
                            <a asp-page="./Details" asp-route-id="@film.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="./Edit" asp-route-id="@film.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@film.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No films found.
        </div>
    }
</div>
