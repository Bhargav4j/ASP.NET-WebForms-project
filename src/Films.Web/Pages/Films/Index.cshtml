@page
@model Films.Web.Pages.Films.IndexModel
@{
    ViewData["Title"] = "Films";
}

<h1>Films</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Film</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Year</th>
            <th>Genre</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Films)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Year</td>
                <td>@item.Genre</td>
                <td>@(item.Description?.Substring(0, Math.Min(50, item.Description?.Length ?? 0)))</td>
                <td>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
