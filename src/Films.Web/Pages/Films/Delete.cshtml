@page "{id:int}"
@model Films.Web.Pages.Films.DeleteModel
@{
    ViewData["Title"] = "Delete Film";
}

<h1>Delete Film</h1>

<h3>Are you sure you want to delete this film?</h3>

@if (Model.Film != null)
{
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@Model.Film.Name</dd>

            <dt class="col-sm-2">Year</dt>
            <dd class="col-sm-10">@Model.Film.Year</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Film.Description</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Film.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
}
else
{
    <p class="alert alert-danger">Film not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
