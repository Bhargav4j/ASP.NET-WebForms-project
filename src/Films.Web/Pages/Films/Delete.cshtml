@page
@model Films.Web.Pages.Films.DeleteModel
@{
    ViewData["Title"] = "Delete Film";
}

<div class="container">
    <h1>Delete Film</h1>
    <hr />
    <h3>Are you sure you want to delete this film?</h3>
    @if (Model.Film != null)
    {
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Film.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Film.Description</dd>

            <dt class="col-sm-3">Year</dt>
            <dd class="col-sm-9">@Model.Film.Year</dd>

            <dt class="col-sm-3">Genre</dt>
            <dd class="col-sm-9">@Model.Film.Genre</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Film.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
    else
    {
        <p class="text-danger">Film not found</p>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
