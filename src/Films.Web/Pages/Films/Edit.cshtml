@page "{id:int}"
@model Films.Web.Pages.Films.EditModel
@{
    ViewData["Title"] = "Edit Film";
}

<h1>Edit Film</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Year" class="form-label"></label>
                <input asp-for="Input.Year" class="form-control" type="number" />
                <span asp-validation-for="Input.Year" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Genre" class="form-label"></label>
                <input asp-for="Input.Genre" class="form-control" />
                <span asp-validation-for="Input.Genre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
