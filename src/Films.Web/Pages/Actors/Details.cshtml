@page
@model Films.Web.Pages.Actors.DetailsModel
@{
    ViewData["Title"] = "Actor Details";
}

<h1>Actor Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.Actor?.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.Actor?.LastName</dd>

        <dt class="col-sm-2">Gender</dt>
        <dd class="col-sm-10">@Model.Actor?.Sex?.Name</dd>

        <dt class="col-sm-2">Created Date</dt>
        <dd class="col-sm-10">@Model.Actor?.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>
<div>
    <a asp-page="Edit" asp-route-id="@Model.Actor?.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
