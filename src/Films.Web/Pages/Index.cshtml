@page
@model Films.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Films Application</h1>
    <p>Web Technologies Project - Exercise</p>
    <p>A modern .NET 8 application for managing films, actors, and directors.</p>
    <a class="btn btn-primary btn-lg" href="https://moodle.unwe.bg" target="_blank">Learn More</a>
</div>

<div class="row mt-5">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Films</h5>
                <p class="card-text">Browse and manage films in the database.</p>
                <a asp-page="/Films/Index" class="btn btn-primary">View Films</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Actors</h5>
                <p class="card-text">Browse and manage actors.</p>
                <a asp-page="/Actors/Index" class="btn btn-primary">View Actors</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Directors</h5>
                <p class="card-text">Browse and manage directors.</p>
                <a asp-page="/Directors/Index" class="btn btn-primary">View Directors</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Users</h5>
                <p class="card-text">Manage user accounts.</p>
                <a asp-page="/Users/Index" class="btn btn-primary">View Users</a>
            </div>
        </div>
    </div>
</div>
