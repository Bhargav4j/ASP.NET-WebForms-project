@page
@model Films.Web.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}
<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-8">
        <h3>About Films Application</h3>
        <p>
            This web application is a project for the web systems development course.
            It demonstrates modern ASP.NET Core development using clean architecture principles.
        </p>

        <h4>Technologies Used</h4>
        <ul>
            <li>ASP.NET Core 8.0</li>
            <li>Entity Framework Core 8.0</li>
            <li>Razor Pages</li>
            <li>SQL Server</li>
            <li>Bootstrap 5</li>
        </ul>

        <h4>Features</h4>
        <ul>
            <li>Film management (CRUD operations)</li>
            <li>Actor and director management</li>
            <li>Search functionality</li>
            <li>Responsive design</li>
            <li>Clean architecture with separation of concerns</li>
        </ul>
    </div>
</div>
